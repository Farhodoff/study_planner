{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/api/telegram/(.*)", "destination": "/api/telegram.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/workbox-(.*).js", "destination": "/workbox-$1.js" },
    { "source": "/((?!api/|sw\\.js|workbox-).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/telegram/notify-daily",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/telegram/dispatch-daily-dataset",
      "schedule": "0 17 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self)"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|logo\\.png|apple-touch-icon\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml|llms\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(sw\\.js|workbox-(.*)\\.js|index\\.html|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/((?!assets/|favicon\\.svg|logo\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml|llms\\.txt).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
